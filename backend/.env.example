# Google Cloud Console OAuth istemcisi (Web application)
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google girişinden sonra kullanıcıyı buraya göndeririz (Vite çoğu zaman 5174)
FRONTEND_URL=http://localhost:5174

# JWT giriş token'ı için en az 32 karakterlik rastgele bir değer kullanın.
# Boş bırakılırsa sunucu her açılışta yeni bir gizli anahtar üretir ve oturumlar düşer.
JWT_SECRET=

# PostgreSQL. backend klasöründe "docker compose up -d" ile açılır.
DB_NAME=testpsikolog
DB_USER=testpsikolog
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/testpsikolog

# Geliştirme için örnek psikolog, danışan ve randevular (@example.test). Production'da açmayın.
# APP_MOCK_DATA=true
# APP_MOCK_PASSWORD=

# Geliştirme için örnek hesap. Production'da açmayın.
# APP_SEED_ENABLED=true
# APP_SEED_USERNAME=devuser
# APP_SEED_PASSWORD=
