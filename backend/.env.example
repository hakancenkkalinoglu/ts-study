# Google OAuth (Google Cloud Console'dan alın)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth callback için backend URL (redirect URI olarak Console'da bunu ekleyin: http://localhost:3000/api/auth/google/callback)
# Oturum sonrası kullanıcıyı yönlendireceğimiz frontend adresi
FRONTEND_URL=http://localhost:5173

# JWT giriş token'ı için (güçlü bir değer kullanın)
JWT_SECRET=your-secret-key-change-in-production
